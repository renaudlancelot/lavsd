@PhdThesis{Lancelot2002,
  author     = {Lancelot, Renaud},
  school     = {Université des Sciences et Techniques du Languedoc},
  title      = {{Croissance pondérale et mortalité des petits ruminants domestiques en Afrique subsaharienne: modélisation statistique}},
  year       = {2002},
  address    = {Montpellier},
  abstract   = {Herds of small ruminants were monitored in Chad and Senegal to (i) identify mortality risk factors, (ii) assess the effect of preventive measures against gastrointestinal parasitism (deworming drug: morantel) and pneumonia (vaccines against peste des petits ruminants (PPR) and respiratory pasteurellosis) on liveweight growth and mortality, and (iii) estimate the effect of low birth weight on mortality. Goats pre-weaning mortality in Chad was studied with a mixed-effects logistic model including a single random effect related to the herd (so-called herd effect). The selection of fixed effects was guided by a conceptual pre-model. The exposure to PPR virus, a low birth weight and an insufficient space in the night housing were identified as the main risk factors. A linear mixed model was used to estimate the effect of morantel on lambs liveweight growth. The random- and fixed-effects structures were chosen after graphical exploratory analysis. The morantel positive effect might have been biased by the censoring of growth data. Growth and growth-censoring processes were jointly modeled to overcome this problem. The estimated bias was lower than the measurement error. Logistic-regression models were used to assess the effects of morantel and pneumonia vaccination on goat mortality. Overdispersion was accounted for by the variance inflation factor. Different a priori models were defined and selected according to the Akaike information criterion. Morantel had a positive effect except during a PPR focus. Marginal and mixed models were compared to estimate the effect of a low birth weight on goat mortality and assess the importance of the herd effect. A low birth weight was associated with a high mortality. Results were more plausible with mixed models than with marginal models. Estimations provided by the Markov chain Monte Carlo model were used to assess the significance of the herd random effect.},
  comment    = {ppr},
  file       = {:Publis/Thèses/Lancelot2002 - Croissance Ponderale Et Mortalite Des Petits Ruminants Domestiques En Afrique Subsaharienne_ Modelisation Statistique.pdf:PDF},
  keywords   = {liveweight growth mortality mixed-effects model herd effect sheep goat Senegal Chad},
  location   = {Montpellier},
  pages      = {224},
  shorttitle = {Croissance pondérale et mortalité des petits ruminants domestiques en Afrique subsaharienne : modélisation statistique},
}

